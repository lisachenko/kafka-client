{
    "name": "lisachenko/kafka-client",
    "description": "Native, pure-PHP implementation of the Apache Kafka wire protocol, with Producer, Consumer and Admin clients",
    "type": "library",
    "license": "MIT",
    "keywords": ["kafka", "apache-kafka", "protocol", "producer", "consumer", "streaming"],
    "authors": [
        {
            "name": "Alexander Lisachenko",
            "email": "lisachenko.it@gmail.com",
            "homepage": "https://github.com/lisachenko"
        }
    ],
    "homepage": "https://github.com/lisachenko/kafka-client",
    "require": {
        "php": "^8.4",
        "react/promise": "^2.7 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.60",
        "rector/rector": "^2.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Protocol\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Protocol\\Kafka\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyze": "phpstan analyse --memory-limit=512M",
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": ["@cs", "@analyze", "@test"]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite",
        "analyze": "Run PHPStan static analysis",
        "cs": "Check coding standards without changing files",
        "cs:fix": "Fix coding-standard violations",
        "check": "Run coding-standards check, static analysis and the test suite"
    }
}
