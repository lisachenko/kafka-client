                "headerTaggedFields": [],
                "timeoutMs": 60000,
                "featureUpdates": {
                    "t1-nonsense": {
                        "feature": "t1-nonsense",
                        "maxVersionLevel": 1,
                        "allowDowngrade": false
                    }
                }
            }
