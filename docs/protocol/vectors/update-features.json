                "correlationId": 9107,
                "headerTaggedFields": [],
                "throttleTimeMs": 0,
                "errorCode": 0,
                "errorMessage": null,
                "results": {
                    "t1-nonsense": {
                        "feature": "t1-nonsense",
                        "errorCode": 42,
                        "errorMessage": "Could not apply finalized feature update because the provided feature is not supported."
                    }
                }
            }
        },
